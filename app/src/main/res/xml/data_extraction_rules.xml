<?xml version="1.0" encoding="utf-8"?>
<!--
  OrchordsAI currently keeps provider/MCP/storage credentials in persistence namespaces that also
  contain ordinary app settings. Until those secrets are separated into dedicated non-backup
  storage (#40/#87), generic Android OS backup and device transfer fail closed. Durable user-data
  portability remains owned by the reviewed first-party backup/sync flows (#229/#230).
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </device-transfer>
</data-extraction-rules>
