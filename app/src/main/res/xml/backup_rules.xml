<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep Android 11-and-lower Auto Backup aligned with the Android 12+ fail-closed policy. OrchordsAI
  currently mixes credential-bearing and ordinary state, so OS-managed backup remains disabled by
  rule until sensitive persistence is separated and an explicit portable allowlist is reviewed.
-->
<full-backup-content>
  <exclude domain="root" path="." />
  <exclude domain="file" path="." />
  <exclude domain="database" path="." />
  <exclude domain="sharedpref" path="." />
  <exclude domain="external" path="." />
</full-backup-content>
