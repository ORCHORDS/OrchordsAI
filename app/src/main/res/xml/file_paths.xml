<?xml version="1.0" encoding="utf-8"?>
<paths>
  <!-- Managed chat attachments that are intentionally shareable. -->
  <files-path
    name="upload"
    path="upload/" />

  <!-- Dedicated cache namespaces used only for explicit share/capture flows. -->
  <cache-path
    name="camera"
    path="camera/" />
  <cache-path
    name="temp"
    path="temp/" />
  <cache-path
    name="export"
    path="export/" />
  <cache-path
    name="workspace_share"
    path="workspace_share/" />
</paths>
